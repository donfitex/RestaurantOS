DJANGO_SETTINGS_MODULE=config.development
SECRET_KEY=replace-with-a-random-secret-at-least-50-characters-long
ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL=postgresql://restaurant:password@localhost:5432/restaurant
CSRF_TRUSTED_ORIGINS=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=restaurant@localhost

# Local Docker Compose (never reuse example passwords)
POSTGRES_USER=restaurant
POSTGRES_DB=restaurant
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
APP_PORT=8000
